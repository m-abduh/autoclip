  <script>
    // Konfirmasi generik untuk tombol hapus.
    document.querySelectorAll("form[data-confirm]").forEach((form) => {
      form.addEventListener("submit", (e) => {
        if (!confirm(form.getAttribute("data-confirm"))) e.preventDefault();
      });
    });
  </script>
