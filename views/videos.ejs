<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Videos</h1>
    <p class="sub">Semua reel yang pernah diunduh dan status upload-nya per kampanye/akun.</p>
  </div>
</div>

<%
  const byVideo = new Map();
  deliveries.forEach((d) => {
    const k = d.owner + '/' + d.shortcode;
    if (!byVideo.has(k)) byVideo.set(k, []);
    byVideo.get(k).push(d);
  });
%>

<section class="panel">
  <table>
    <thead>
      <tr><th>Owner</th><th>Shortcode</th><th>Status</th><th>Upload</th><th>Terunduh</th></tr>
    </thead>
    <tbody>
      <% if (!videos.length) { %>
        <tr><td colspan="5" class="empty">Belum ada video</td></tr>
      <% } %>
      <% videos.forEach((v) => {
        const list = byVideo.get(v.owner + '/' + v.shortcode) || [];
        const ok = list.filter((d) => d.status === 'uploaded').length;
        const bad = list.filter((d) => d.status === 'failed').length;
        const st = ok && !bad ? 'uploaded' : ok ? 'partial' : bad ? 'failed' : 'downloaded';
      %>
        <tr>
          <td>@<%= v.owner %></td>
          <td class="mono"><%= v.shortcode %></td>
          <td><span class="badge <%= st %>"><%= st %></span></td>
          <td class="channels">
            <% if (!list.length) { %><span class="empty">-</span><% } %>
            <% list.forEach((d) => { %>
              <span class="chip <%= d.status %>" title="<%= d.error || '' %>">
                <%= campaignNames.get(d.campaignId) || '#' + d.campaignId %> ·
                <%= d.service %> · <%= d.status %>
                <% if (d.bufferPostId) { %>(<%= d.bufferPostId %>)<% } %>
              </span>
            <% }) %>
          </td>
          <td class="mono"><%= (v.downloadedAt || '').slice(0, 16).replace('T', ' ') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('partials/footer') %>
