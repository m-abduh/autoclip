<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Settings</h1>
    <p class="sub">Pengaturan global yang berlaku untuk semua kampanye.</p>
  </div>
</div>

<section class="panel">
  <form method="post" action="/settings" class="form">
    <div class="row">
      <label>Interval siklus</label>
      <select name="intervalHours">
        <% for (const h of intervals) { %>
          <option value="<%= h %>" <%= settings.intervalHours === h ? 'selected' : '' %>>
            tiap <%= h %> jam
          </option>
        <% } %>
      </select>
      <small>Tiap siklus: rotasi username per kampanye → ambil 1 video terbaru → distribusi ke akun Buffer kampanye.</small>
    </div>

    <div class="row">
      <label>Jumlah video terbaru per siklus</label>
      <select name="fetchBatchSize">
        <% for (const n of [1, 2, 4, 8, 12]) { %>
          <option value="<%= n %>" <%= settings.fetchBatchSize === n ? 'selected' : '' %>>
            <%= n %> video terbaru
          </option>
        <% } %>
      </select>
      <small>1 = tiap siklus cuma ambil video paling baru; sisanya menyusul siklus berikutnya (tidak terlewat).</small>
    </div>

    <div class="row">
      <label>Caption template (universal)</label>
      <textarea name="captionTemplate" rows="4"><%= settings.captionTemplate %></textarea>
      <small>Placeholder: <code>{caption}</code> <code>{username}</code> <code>{shortcode}</code></small>
    </div>

    <div class="row">
      <label>Platform tujuan (channel di-discover otomatis dari tiap akun Buffer)</label>
      <div class="checks">
        <% for (const s of ['instagram', 'tiktok', 'youtube']) { %>
          <label class="check">
            <input type="checkbox" name="services" value="<%= s %>"
              <%= (settings.services || []).includes(s) ? 'checked' : '' %> />
            <%= s %>
          </label>
        <% } %>
      </div>
    </div>

    <div class="row inline">
      <label><input type="checkbox" name="autoUpload" <%= settings.autoUpload ? 'checked' : '' %> /> Auto upload ke Buffer</label>
    </div>

    <button type="submit" class="btn primary">Simpan settings</button>
  </form>
</section>

<section class="panel">
  <div class="panel-head"><h2>Environment</h2></div>
  <table>
    <tr><td>Database</td><td class="mono">Prisma Postgres (DATABASE_URL) <% if (process.env.DATABASE_URL) { %><span class="badge uploaded">terhubung</span><% } else { %><span class="badge failed">belum diisi</span><% } %></td></tr>
    <tr><td>PUBLIC_BASE_URL</td><td class="mono"><%= process.env.PUBLIC_BASE_URL || '(belum diisi)' %></td></tr>
    <tr><td>DOWNLOAD_DIR</td><td class="mono"><%= process.env.DOWNLOAD_DIR || 'downloads' %></td></tr>
    <tr><td>BUFFER_MODE</td><td class="mono"><%= process.env.BUFFER_MODE || 'shareNow' %></td></tr>
  </table>
  <p class="hint" style="margin-top:12px">
    Akun Buffer tidak lagi diambil dari <code>.env</code> — tambahkan per kampanye di halaman
    <a href="/campaigns">Kampanye</a>.
  </p>
</section>

<%- include('partials/footer') %>
