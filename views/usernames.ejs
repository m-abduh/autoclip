<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Usernames</h1>
    <p class="sub">Semua sumber Instagram lintas kampanye. Tambah/hapus dari halaman kampanye.</p>
  </div>
</div>

<section class="panel">
  <table>
    <thead><tr><th>Kampanye</th><th>Username</th><th>Status</th><th>Seen</th><th>Ditambahkan</th></tr></thead>
    <tbody>
      <% if (!usernames.length) { %>
        <tr><td colspan="5" class="empty">Belum ada username. <a href="/campaigns">Buat kampanye</a> dulu.</td></tr>
      <% } %>
      <% usernames.forEach((u) => { %>
        <tr>
          <td><a href="/campaigns/<%= u.campaignId %>"><%= u.campaignName %></a></td>
          <td>@<%= u.username %></td>
          <td>
            <span class="badge <%= u.enabled ? 'uploaded' : 'skipped' %>"><%= u.enabled ? 'aktif' : 'nonaktif' %></span>
            <% if (!u.campaignEnabled) { %><span class="badge skipped">kampanye off</span><% } %>
          </td>
          <td class="mono"><%= (u.seen || []).length %></td>
          <td class="mono"><%= (u.createdAt || '').slice(0, 10) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('partials/footer') %>
