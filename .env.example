# ============================================================
#  AutoClip — contoh konfigurasi (.env.example)
#  Salin jadi .env lalu isi bagian A.
# ============================================================

# ---------- A. WAJIB DIISI ----------

# Database Postgres (Prisma Postgres). Salin connection string dari dashboard
# Prisma: postgres://user:pass@pooled.db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=

# URL publik server ini. Buffer mengambil video dari sini, jadi HARUS
# bisa diakses dari internet (bukan localhost).
# Contoh: https://autoclip.domain.com   |   http://1.2.3.4:3000
PUBLIC_BASE_URL=


# ---------- B. OPSIONAL — default sudah aman ----------

# Port web. Buka http://localhost:<PORT>
PORT=3000

# Interval siklus (jam): tiap interval → fetch 1 video terbaru per kampanye
# → unduh → upload ke semua akun Buffer kampanye.
# Hanya: 1,2,4,5,6,7,8. Bisa diubah dari halaman Settings.
INTERVAL_HOURS=1

# Mode publikasi Buffer: shareNow (langsung) | addToQueue | customScheduled
BUFFER_MODE=shareNow

# Default video YouTube
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=24


# ---------- C. JARANG DISENTUH ----------

# Lokasi folder simpan video
DOWNLOAD_DIR=downloads

# Alamat API Buffer (jangan diubah)
BUFFER_API_URL=https://api.buffer.com

# Kedalaman paginasi Instagram per siklus
IG_MAX_PAGES=8
# Halaman tab Reels yang diambil saat scan
IG_REEL_PAGES=5

# Maksimum koneksi pool Postgres
PG_POOL_MAX=10
